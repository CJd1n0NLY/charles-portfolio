generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
}

model Project {
  id           String         @id @default(cuid())
  slug         String         @unique
  chapter      String         // "ACADEMIC", "INTERNSHIP", "CAPSTONE", "PERSONAL"
  title        String
  tagline      String
  status       String         @default("DRAFT") // "DRAFT" | "PUBLISHED"
  buildStatus  String         @default("IN_PROGRESS") // Stored as string for SQLite: "SHIPPED" | "IN_PROGRESS" | "ARCHIVED"
  
  problem      String?        // Removed @db.Text
  approach     String?        // Removed @db.Text
  outcome      String?        // Removed @db.Text
  techStack    String?
  liveUrl      String?
  repoUrl      String?
  heroImageUrl String?
  
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  challenges   Challenge[]
  gallery      GalleryImage[]
}

model Challenge {
  id          String  @id @default(cuid())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String  
  order       Int     @default(0)
}

model GalleryImage {
  id          String  @id @default(cuid())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  url         String
  altText     String  // Added per accessibility guardrails
  caption     String?
  order       Int     @default(0)
}

model ChapterIntro {
  id          String   @id @default(cuid())
  chapter     String   @unique // "ACADEMIC" | "INTERNSHIP" | "CAPSTONE" | "PERSONAL"
  heading     String
  narrative   String   
}

model Skill {
  id       String  @id @default(cuid())
  category String  // "LANGUAGE" | "FRAMEWORK" | "DATABASE" | "TOOL" | "METHODOLOGY"
  name     String
  order    Int     @default(0)
}

model WorkExperience {
  id              String             @id @default(cuid())
  slug            String            @unique
  company         String
  role            String
  location        String?
  startDate       DateTime
  endDate         DateTime?
  supervisorName  String?
  tagline         String?
  context         String?            
  roleProgression String?            
  outcome         String?            
  evaluationScore Int?
  evaluationQuote String?            
  order           Int                @default(0)
  contributions   WorkContribution[]
}

model WorkContribution {
  id               String         @id @default(cuid())
  title            String
  description      String         
  order            Int            @default(0)
  
  workExperienceId String
  workExperience   WorkExperience @relation(fields: [workExperienceId], references: [id], onDelete: Cascade)
}

model Certificate {
  id           String    @id @default(cuid())
  title        String
  issuer       String
  dateIssued   DateTime?
  imageUrl     String
  reviewStatus String    @default("PENDING") // "PENDING" | "LOOKS_VALID" | "FLAGGED_FOR_REVIEW"
  reviewNotes  String?   
  order        Int       @default(0)
}

model Education {
  id        String  @id @default(cuid())
  school    String
  degree    String
  section   String?
  honors    String?
  startYear Int
  endYear   Int
}

model SiteSettings {
  id              String  @id @default("global")
  heroPortraitUrl String?
  aboutPhotoUrl   String?
}